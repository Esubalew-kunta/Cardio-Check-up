# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# never committed. Leave these two unset and the site keeps reading the blog
# from static data (src/data/site.js) with no change in behavior — see
# SUPABASE_SETUP.md.

# Supabase project URL — Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe for the browser; RLS restricts it to
# published posts only) — Project Settings → API → Project API keys → anon public
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Existing, unrelated to this change: the RAG chat backend URL (documented in
# content/PROJECT-STATUS.md). Included here since this is the project's only
# .env.example.
VITE_CHAT_API_URL=https://cardio-rag-backend.onrender.com
